# Copy to /etc/sleeper-agent/sleeper-agent.env, then: chmod 600, chown sleeper:sleeper
#
# Every secret lives here rather than in config.yaml. `sa` reads them at
# startup, and `Config::save()` deliberately never writes an env-sourced
# secret back to disk — so the settings UI can't leak them into config.yaml.

# Which config to load (overrides the ./config.yaml + ~/.config lookup).
SA_CONFIG=/etc/sleeper-agent/config.yaml

# Player DB cache (~5 MB) + the alert-dedupe state file. Must be writable.
SA_CACHE_DIR=/var/cache/sleeper-agent

# Claude access — ONE of the two:
#   1. API key (recommended for a headless server; no interactive login)
ANTHROPIC_API_KEY=sk-ant-...
#   2. Or leave the key unset and set `anthropic.backend: claude-cli` in
#      config.yaml to use a Claude Pro/Max subscription. See README for the
#      extra unit-file changes that needs.

# Discord (or any) incoming webhook. Empty/unset disables notifications.
SA_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Quiet hours in config.yaml are evaluated in local time — make sure the
# container's zone is right (`timedatectl set-timezone America/New_York`)
# or pin it here.
TZ=America/New_York

# Optional: quieter or louder logs. Default is info.
# RUST_LOG=sleeper_agent=debug
